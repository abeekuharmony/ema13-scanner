//@version=6
// Asman Gold Body Cross v7.1 — XAUUSD — same rules on every timeframe (M5, H1, H4 ...)
// Signal: candle BODY crosses EMA13 (open one side, close the other) AND:
//   A) Volume spike: the signal candle's volume >= 1.5x the average volume of the previous 20 candles
//   B) TMA rule 2: invalid if the candle's high-low range covers >= 75% of the TMA channel width
//   C) TMA rule 3: BUY only if the candle OPENED BELOW the TMA middle line, SELL only if it OPENED ABOVE it
// TMA = Brylator "TMA Centered Bands" v0.42 settings (half period 12, Weighted price, ATR 100 x 2),
// using the values that were LIVE when the candle closed (no repaint). No TMA colour rule.
// Out-of-session signals are still BUY/SELL, marked with a * in the label.
// Closed candles only => no repaint.
indicator("Asman Gold Body Cross v7.1", overlay = true, max_labels_count = 500)

grpE = "EMAs"
lenFast = input.int(5,  "Fast EMA",   minval = 1, group = grpE)
lenMid  = input.int(13, "Signal EMA", minval = 1, group = grpE)
lenSlow = input.int(62, "Slow EMA",   minval = 1, group = grpE)
colFast = input.color(color.purple, "Fast colour",   group = grpE)
colMid  = input.color(color.yellow, "Signal colour", group = grpE)
colSlow = input.color(color.green,  "Slow colour",   group = grpE)

grpV = "Volume spike"
rvolMult = input.float(1.5, "Volume must be at least (x average)", minval = 0.1, step = 0.1, group = grpV)
rvolLen  = input.int(20, "Average of the previous N candles", minval = 1, group = grpV)

grpT = "TMA Centered Bands (match your TMA v0.42 settings)"
tmaHalf  = input.int(12, "Centered TMA half period", minval = 1, group = grpT)
tmaAtrP  = input.int(100, "ATR period", minval = 1, group = grpT)
tmaMult  = input.float(2.0, "ATR multiplier", minval = 0.1, step = 0.1, group = grpT)
r2Pct    = input.float(75, "Block if candle range >= % of channel width", minval = 1, maxval = 200, group = grpT)
showLive = input.bool(false, "Show the LIVE TMA middle line used by the rules", group = grpT)

grpS = "Session marker (M5 and H1 only)"
markOOS    = input.bool(true,  "Add * to out-of-session signals (e.g. M5 BUY *)", group = grpS)
shadeOOS   = input.bool(false, "Faintly shade out-of-session hours", group = grpS)
sessPreset = input.string("Tight: 00-07 + 12-16", "Session (UTC)", options = ["Tight: 00-07 + 12-16", "Loose: 00-21"], group = grpS)

plot(ta.ema(close, lenFast), "EMA Fast",   colFast)
plot(ta.ema(close, lenMid),  "EMA Signal", colMid, 2)
plot(ta.ema(close, lenSlow), "EMA Slow",   colSlow)

tfSec   = timeframe.in_seconds()
tfLabel = timeframe.period == "5" ? "M5" : timeframe.period == "60" ? "H1" : timeframe.period == "240" ? "H4" : timeframe.period
conf    = barstate.isconfirmed

inSession(int t) =>
    h = hour(t, "UTC")
    sessPreset == "Tight: 00-07 + 12-16" ? (h < 7 or (h >= 12 and h < 16)) : h < 21

// ---- live TMA (right edge of the TMA Centered Bands: past candles only) ----
tmaPrice = (high + low + 2 * close) / 4                       // "Weighted" price
tmaMid   = ta.wma(tmaPrice, tmaHalf + 1)
tr2      = math.max(high, nz(close[1], close)) - math.min(low, nz(close[1], close))
chanW    = 2 * tmaMult * ta.sma(tr2, tmaAtrP)[10]             // upper band - lower band
plot(showLive ? tmaMid : na, "Live TMA mid", color.new(color.gray, 30), 1)

volOk  = volume >= rvolMult * ta.sma(volume, rvolLen)[1]
rangeOk = (high - low) < r2Pct / 100 * chanW

m       = ta.ema(close, lenMid)
buySig  = open < m and close > m and volOk and rangeOk and open < tmaMid and conf
sellSig = open > m and close < m and volOk and rangeOk and open > tmaMid and conf
outSess = tfSec < 14400 and not inSession(time)               // H4+ never marked
star    = markOOS and outSess ? " *" : ""
oosNote = markOOS and outSess ? " (out of session)" : ""

bgcolor(shadeOOS and outSess ? color.new(#4FC3F7, 93) : na, title = "Out-of-session shading")

if buySig
    label.new(bar_index, low, tfLabel + " BUY" + star, yloc = yloc.belowbar, style = label.style_label_up,
              color = #43A047, textcolor = color.white, size = size.small)
    alert(tfLabel + " BUY" + oosNote + " — " + syminfo.ticker, alert.freq_once_per_bar_close)
if sellSig
    label.new(bar_index, high, tfLabel + " SELL" + star, yloc = yloc.abovebar, style = label.style_label_down,
              color = #E53935, textcolor = color.white, size = size.small)
    alert(tfLabel + " SELL" + oosNote + " — " + syminfo.ticker, alert.freq_once_per_bar_close)

alertcondition(buySig,  "BUY",  "{{interval}} BUY — {{ticker}}")
alertcondition(sellSig, "SELL", "{{interval}} SELL — {{ticker}}")
